{
  "expo": {
    "name": "StudentManagementApp",
    "slug": "StudentManagementApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "studentmanagementapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.phattt30012004.StudentManagementApp"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F0F6FF",
          "dark": {
            "backgroundColor": "#102C51"
          },
          "image": "./src/assets/brand/pp-academy-logo.png"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
